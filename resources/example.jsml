<h1>btick example</h1>

${{
    const: {
        appName: "btick"
    },
    emphasis: "<b>template scope works</b>"
}}

<p>Engine: ${({ appName }) => appName}</p>
<p>Status: ${({ emphasis }) => emphasis}</p>

<p>
    Greeting: ${() => {
        const timeOfDay = (new Date()).getHours() > 11 ? "evening" : "morning";
        return name[timeOfDay];
    }}
</p>

<p>Current time: ${new Date().toISOString()}</p>

<h2>Inline mapping</h2>
<ul>
${() => [1, 2, 3, 4, 5].map((item) => `<li>Item ${item}</li>`).join('')}
</ul>

<h2>Capture group loop</h2>
<ul>
${capture}
    <li>Captured item ${ctx.i}</li>
${capture.end(async (render) => {
    let out = '';
    for (let i = 1; i <= 3; i++) {
        out += await render({ i });
    }
    return out;
})}
</ul>